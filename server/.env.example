# Скопируйте в .env (node --env-file=.env) или вынесите в переменные окружения хостинга.

# OAuth Client ID (тип «Web application») из Google Cloud Console.
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Секрет сессий: длинная случайная строка (≥16 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=замените-на-случайную-строку-64-символа

# Порт HTTP.
PORT=3000

# Файл SQLite (по умолчанию server/data/leaderboard.db).
#DB_FILE=./data/leaderboard.db

# Домены фронтенда, которым разрешён CORS, через запятую. «*» — только для dev.
# Пример: CORS_ORIGINS=https://mahjongdle.example.com,https://you.github.io
CORS_ORIGINS=*

# Бэкап БД в приватный GitHub-репо (защита от эфемерного диска Render).
# Без этих переменных бэкап выключен. Токен: fine-grained PAT, доступ только
# к репо, permission Contents: Read and write.
#BACKUP_GITHUB_REPO=nprarvskiy/mahjongdle-data
#BACKUP_GITHUB_TOKEN=github_pat_…xxxx
#BACKUP_FILE=leaderboard.db
#BACKUP_BRANCH=main
